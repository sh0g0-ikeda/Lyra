EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_CLIENT_ID=your_cognito_app_client_id
EXPO_PUBLIC_COGNITO_REDIRECT_URI=lyra-mobile://auth/mobile/callback
EXPO_PUBLIC_COGNITO_LOGOUT_REDIRECT_URI=lyra-mobile://auth/mobile/logout
EXPO_PUBLIC_COGNITO_SCOPES=openid,email,profile
EXPO_PUBLIC_COGNITO_API_TOKEN_USE=id_token
EXPO_PUBLIC_ORGANIZATION_FEATURES_ENABLED=false
EXPO_PUBLIC_MOBILE_STORE_BILLING_ENABLED=false
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
EXPO_PUBLIC_EPISODE_EXPORT_ENABLED=false
EXPO_PUBLIC_IOS_ASSOCIATED_DOMAINS_ENABLED=false
EXPO_PUBLIC_BUILD_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_DSN=
