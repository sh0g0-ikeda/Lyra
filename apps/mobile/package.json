{
  "name": "lyra-mobile",
  "version": "1.0.2",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo-sharing"
      ]
    }
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:dev-client": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "contracts:check": "node ../../scripts/generateMobileApiContract.mjs --check",
    "check:mojibake": "node scripts/checkMojibake.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "e2e:maestro:staging": "node scripts/runMaestroStaging.mjs",
    "e2e:maestro:store": "node scripts/runMaestroStaging.mjs --scenarios=E2E-15",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.13",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.7",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-iap": "^4.7.0",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.10",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.9",
    "expo-splash-screen": "~57.0.6",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19.2.17",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
