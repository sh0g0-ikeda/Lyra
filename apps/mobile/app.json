{
  "expo": {
    "name": "Lyra Mobile",
    "slug": "lyra-mobile",
    "scheme": "lyra-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0b"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f1e8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
