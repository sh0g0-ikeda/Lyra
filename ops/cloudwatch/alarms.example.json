{
  "alarms": [
    {
      "name": "lyra-alb-5xx-high",
      "namespace": "AWS/ApplicationELB",
      "metric_name": "HTTPCode_Target_5XX_Count",
      "statistic": "Sum",
      "threshold": 5,
      "period_seconds": 60,
      "evaluation_periods": 3,
      "comparison_operator": "GreaterThanThreshold",
      "dimensions": {
        "LoadBalancer": "app/lyra-api/replace-me"
      },
      "alarm_actions": ["arn:aws:sns:ap-northeast-1:123456789012:lyra-alerts"]
    },
    {
      "name": "lyra-api-ecs-cpu-high",
      "namespace": "AWS/ECS",
      "metric_name": "CPUUtilization",
      "statistic": "Average",
      "threshold": 80,
      "period_seconds": 300,
      "evaluation_periods": 3,
      "comparison_operator": "GreaterThanThreshold",
      "dimensions": {
        "ClusterName": "lyra-production",
        "ServiceName": "lyra-api"
      },
      "alarm_actions": ["arn:aws:sns:ap-northeast-1:123456789012:lyra-alerts"]
    },
    {
      "name": "lyra-api-ecs-memory-high",
      "namespace": "AWS/ECS",
      "metric_name": "MemoryUtilization",
      "statistic": "Average",
      "threshold": 85,
      "period_seconds": 300,
      "evaluation_periods": 3,
      "comparison_operator": "GreaterThanThreshold",
      "dimensions": {
        "ClusterName": "lyra-production",
        "ServiceName": "lyra-api"
      },
      "alarm_actions": ["arn:aws:sns:ap-northeast-1:123456789012:lyra-alerts"]
    },
    {
      "name": "lyra-worker-ecs-cpu-high",
      "namespace": "AWS/ECS",
      "metric_name": "CPUUtilization",
      "statistic": "Average",
      "threshold": 80,
      "period_seconds": 300,
      "evaluation_periods": 3,
      "comparison_operator": "GreaterThanThreshold",
      "dimensions": {
        "ClusterName": "lyra-production",
        "ServiceName": "lyra-generation-worker"
      },
      "alarm_actions": ["arn:aws:sns:ap-northeast-1:123456789012:lyra-alerts"]
    },
    {
      "name": "lyra-generation-queue-oldest-message-high",
      "namespace": "AWS/SQS",
      "metric_name": "ApproximateAgeOfOldestMessage",
      "statistic": "Maximum",
      "threshold": 600,
      "period_seconds": 60,
      "evaluation_periods": 5,
      "comparison_operator": "GreaterThanThreshold",
      "dimensions": {
        "QueueName": "lyra-generation"
      },
      "alarm_actions": ["arn:aws:sns:ap-northeast-1:123456789012:lyra-alerts"]
    },
    {
      "name": "lyra-generation-dlq-visible-messages",
      "namespace": "AWS/SQS",
      "metric_name": "ApproximateNumberOfMessagesVisible",
      "statistic": "Maximum",
      "threshold": 0,
      "period_seconds": 60,
      "evaluation_periods": 1,
      "comparison_operator": "GreaterThanThreshold",
      "dimensions": {
        "QueueName": "lyra-generation-dlq"
      },
      "alarm_actions": ["arn:aws:sns:ap-northeast-1:123456789012:lyra-alerts"]
    }
  ]
}
