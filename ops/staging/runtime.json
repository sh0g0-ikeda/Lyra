{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "ResourcePrefix": {
      "Type": "String",
      "AllowedPattern": "^lyra-staging-[a-z0-9-]+$"
    },
    "ExpiresAt": {
      "Type": "String"
    },
    "AssetsBucketName": {
      "Type": "String"
    },
    "KmsKeyArn": {
      "Type": "String"
    },
    "GenerationQueueArn": {
      "Type": "String"
    },
    "ExportQueueArn": {
      "Type": "String"
    },
    "RuntimeSecretArn": {
      "Type": "String"
    },
    "ApiLogGroupName": {
      "Type": "String"
    },
    "WorkerLogGroupName": {
      "Type": "String"
    },
    "ClusterArn": {
      "Type": "String"
    },
    "ApiTargetGroupArn": {
      "Type": "String"
    },
    "PublicSubnetAId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "PublicSubnetCId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "ApiSG": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "WorkerSG": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "ContainerImage": {
      "Type": "String"
    },
    "WorkloadBoundaryArn": {
      "Type": "String"
    },
    "ProductionDeniedArns": {
      "Type": "CommaDelimitedList"
    },
    "DesiredApiCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "DesiredGenerationCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "DesiredExportCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "DesiredDeletionCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    }
  },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ResourcePrefix}-execution"
        },
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "own-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${ResourcePrefix}-api"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${ApiLogGroupName}:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${WorkerLogGroupName}:*"
                    }
                  ]
                },
                {
                  "Effect": "Deny",
                  "Action": "*",
                  "Resource": {
                    "Ref": "ProductionDeniedArns"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "ApiTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ResourcePrefix}-api-task"
        },
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "api-scope",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "RuntimeSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Ref": "KmsKeyArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AssetsBucketName}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": [
                    {
                      "Ref": "GenerationQueueArn"
                    },
                    {
                      "Ref": "ExportQueueArn"
                    }
                  ]
                },
                {
                  "Effect": "Deny",
                  "Action": "*",
                  "Resource": {
                    "Ref": "ProductionDeniedArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AssetsBucketName}"
                  }
                },
                {
                  "Sid": "AssumeExactStageStateV2Roles",
                  "Effect": "Allow",
                  "Action": "sts:AssumeRole",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ResourcePrefix}-state-v2-image-create"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ResourcePrefix}-state-v2-recovery"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "WorkerTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ResourcePrefix}-worker-task"
        },
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "worker-scope",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "RuntimeSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Ref": "KmsKeyArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AssetsBucketName}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes",
                    "sqs:SendMessage",
                    "sqs:ChangeMessageVisibility"
                  ],
                  "Resource": [
                    {
                      "Ref": "GenerationQueueArn"
                    },
                    {
                      "Ref": "ExportQueueArn"
                    }
                  ]
                },
                {
                  "Effect": "Deny",
                  "Action": "*",
                  "Resource": {
                    "Ref": "ProductionDeniedArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${AssetsBucketName}"
                  }
                },
                {
                  "Sid": "OwnTaskScaleInProtection",
                  "Effect": "Allow",
                  "Action": [
                    "ecs:GetTaskProtection",
                    "ecs:UpdateTaskProtection"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:task/${ClusterName}/*"
                  },
                  "Condition": {
                    "ArnEquals": {
                      "ecs:cluster": {
                        "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:cluster/${ClusterName}"
                      }
                    }
                  }
                },
                {
                  "Sid": "AssumeExactStageStateV2RecoveryRole",
                  "Effect": "Allow",
                  "Action": "sts:AssumeRole",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ResourcePrefix}-state-v2-recovery"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "MigrationTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${ResourcePrefix}-migration-task"
        },
        "PermissionsBoundary": {
          "Ref": "WorkloadBoundaryArn"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "migration-minimal",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "RuntimeSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Ref": "KmsKeyArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${WorkerLogGroupName}:*"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": "*",
                  "Resource": {
                    "Ref": "ProductionDeniedArns"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "ApiTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${ResourcePrefix}-api"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "ApiTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Ref": "ContainerImage"
            },
            "Command": [
              "/usr/local/bin/bun",
              "dist/scripts/startProductionApi.js"
            ],
            "PortMappings": [
              {
                "ContainerPort": 3000
              }
            ],
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "APP_ENV",
                "Value": "staging"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "LYRA_APP_SECRET_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              },
              {
                "Name": "STAGING_SECRET_SOURCE_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "ApiLogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "GenerationTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${ResourcePrefix}-generation"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "WorkerTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "generation",
            "Image": {
              "Ref": "ContainerImage"
            },
            "Command": [
              "/usr/local/bin/bun",
              "dist/scripts/startProductionWorker.js"
            ],
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "APP_ENV",
                "Value": "staging"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "LYRA_APP_SECRET_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              },
              {
                "Name": "STAGING_SECRET_SOURCE_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              },
              {
                "Name": "ECS_TASK_SCALE_IN_PROTECTION_ENABLED",
                "Value": "true"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "generation"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "ExportTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${ResourcePrefix}-export"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "WorkerTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "export",
            "Image": {
              "Ref": "ContainerImage"
            },
            "Command": [
              "/usr/local/bin/bun",
              "dist/scripts/startProductionEpisodeExportWorker.js"
            ],
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "APP_ENV",
                "Value": "staging"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "LYRA_APP_SECRET_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              },
              {
                "Name": "STAGING_SECRET_SOURCE_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "export"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "DeletionTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${ResourcePrefix}-deletion"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "WorkerTaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "deletion",
            "Image": {
              "Ref": "ContainerImage"
            },
            "Command": [
              "/usr/local/bin/bun",
              "dist/scripts/startProductionAccountDeletionWorker.js"
            ],
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "APP_ENV",
                "Value": "staging"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "LYRA_APP_SECRET_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              },
              {
                "Name": "STAGING_SECRET_SOURCE_ID",
                "Value": {
                  "Ref": "RuntimeSecretArn"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "WorkerLogGroupName"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "deletion"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          }
        ]
      }
    },
    "MigrationTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${ResourcePrefix}-migration"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
