{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated Lyra staging foundation. Teardown must be deliberate: the database snapshots and the versioned assets bucket is retained.",
  "Parameters": {
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "OriginHostname": {
      "Type": "String",
      "AllowedPattern": "^origin-staging-[a-z0-9-]+\\.lyra-editor\\.com$"
    },
    "ResourcePrefix": {
      "Type": "String",
      "Default": "lyra-staging-20261003",
      "AllowedPattern": "^lyra-staging-[a-z0-9-]+$",
      "MaxLength": 26
    },
    "ExpiresAt": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "Resources": {
    "StagingVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.77.0.0/16",
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ResourcePrefix}-vpc"
            }
          },
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ResourcePrefix}-igw"
            }
          },
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "PublicInternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "AvailabilityZone": "ap-northeast-1a",
        "CidrBlock": "10.77.0.0/24",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "PublicSubnetC": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "AvailabilityZone": "ap-northeast-1c",
        "CidrBlock": "10.77.1.0/24",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "PrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "AvailabilityZone": "ap-northeast-1a",
        "CidrBlock": "10.77.10.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "PrivateSubnetC": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "AvailabilityZone": "ap-northeast-1c",
        "CidrBlock": "10.77.11.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "PublicSubnetARouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetA"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PublicSubnetCRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetC"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        }
      }
    },
    "PrivateSubnetARouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetA"
        },
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "PrivateSubnetCRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetC"
        },
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS only",
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "DestinationSecurityGroupId": {
              "Fn::GetAtt": [
                "TasksSecurityGroup",
                "GroupId"
              ]
            },
            "Description": "API tasks only"
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "TasksSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "ALB task ingress only",
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "worker has no ingress",
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL from tasks/workers only",
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "icmp",
            "FromPort": 252,
            "ToPort": 86,
            "CidrIp": "255.255.255.255/32",
            "Description": "Disallow all traffic"
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "AlbIngressHttps": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "AlbSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "CidrIp": "0.0.0.0/0"
      }
    },
    "TasksIngressFromAlb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "TasksSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 3000,
        "ToPort": 3000,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "AlbSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "DatabaseIngressFromTasks": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "DatabaseSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "TasksSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "DatabaseIngressFromWorker": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "DatabaseSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "WorkerSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "TasksHttpsEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "TasksSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "CidrIp": "0.0.0.0/0"
      }
    },
    "TasksDatabaseEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "TasksSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": [
            "DatabaseSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "WorkerHttpsEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "WorkerSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "CidrIp": "0.0.0.0/0"
      }
    },
    "WorkerDatabaseEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "WorkerSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": [
            "DatabaseSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "OriginCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {
          "Ref": "OriginHostname"
        },
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Ref": "OriginHostname"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "OriginDnsRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "OriginHostname"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "ApplicationLoadBalancer",
              "DNSName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "ApplicationLoadBalancer",
              "CanonicalHostedZoneID"
            ]
          },
          "EvaluateTargetHealth": false
        }
      }
    },
    "ApplicationLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "SecurityGroups": [
          {
            "Fn::GetAtt": [
              "AlbSecurityGroup",
              "GroupId"
            ]
          }
        ],
        "Subnets": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetC"
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ],
        "Name": {
          "Fn::Sub": "${ResourcePrefix}-alb"
        }
      }
    },
    "ApiTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "StagingVpc"
        },
        "TargetType": "ip",
        "Protocol": "HTTP",
        "Port": 3000,
        "HealthCheckPath": "/readyz",
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ],
        "Name": {
          "Fn::Sub": "${ResourcePrefix}-api"
        }
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ApplicationLoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "OriginCertificate"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "ApiTargetGroup"
            }
          }
        ]
      }
    },
    "StagingKmsKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "StagingAssetsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "aws:kms",
                "KMSMasterKeyID": {
                  "Fn::GetAtt": [
                    "StagingKmsKey",
                    "Arn"
                  ]
                }
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ],
        "BucketName": {
          "Fn::Sub": "${ResourcePrefix}-images-${AWS::AccountId}"
        }
      }
    },
    "BuildSourceBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${ResourcePrefix}-build-${AWS::AccountId}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-build-sources",
              "Status": "Enabled",
              "ExpirationInDays": 7
            }
          ]
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ]
      }
    },
    "DatabaseCredentials": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"lyra_staging\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Owner",
            "Value": "Lyra"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ExpiresAt",
            "Value": {
              "Ref": "ExpiresAt"
            }
          },
          {
            "Key": "LyraStagingId",
            "Value": {
              "Ref": "ResourcePrefix"
            }
          }
        ],
        "Name": {
          "Fn::Sub": "${ResourcePrefix}-db"
        },
        "KmsKeyId": {
          "Fn::GetAtt": [
            "StagingKmsKey",
            "Arn"
          ]
        }
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "private staging database",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnetA"
          },
          {
            "Ref": "PrivateSubnetC"
          }
        ],
        "Tags": [
          {
            "Key": "Owner",
