PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lyra
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
# Comma-separated browser origins allowed to call /api/* when the web app and API use separate domains.
# Leave empty for same-origin CloudFront routing.
# CORS_ALLOWED_ORIGINS=https://app.lyra.test
# Local development can auto-apply SQL migrations on API startup.
# Production should keep this false and run `npm run migrate` as a one-off deploy task.
AUTO_RUN_MIGRATIONS=true
AWS_REGION=ap-northeast-1
SQS_QUEUE_URL_GENERATION=https://sqs.ap-northeast-1.amazonaws.com/123456789012/lyra-generation
SQS_GENERATION_VISIBILITY_TIMEOUT_SECONDS=420
S3_BUCKET_IMAGES=lyra-images
IMAGES_CDN_BASE_URL=https://img.lyra.app
LOCAL_FILE_STORAGE_DIR=.localdata/assets
LOCAL_ASSET_BASE_URL=http://127.0.0.1:3000/local-assets
LOCAL_IMAGE_FALLBACK_ENABLED=false
OPENAI_API_KEY=replace-me
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=300000
LLM_PAGE_PROMPT_COMPILER_ENABLED=false
LLM_ENTITY_REFERENCE_PROMPT_COMPILER_ENABLED=false
LLM_PAGE_GENERATION_PLANNER_ENABLED=false
GENERATION_USER_ACTIVE_JOB_LIMIT=2
GENERATION_GLOBAL_ACTIVE_JOB_LIMIT=10
GENERATION_ENABLED=true
STRIPE_SECRET_KEY=replace-me-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-me-stripe-webhook-secret
STRIPE_PRICE_STANDARD_MONTHLY=price_standard_replace_me
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_replace_me
STRIPE_PRICE_CREDITS_200=price_credits_200_replace_me
STRIPE_PRICE_CREDITS_1000=price_credits_1000_replace_me
STRIPE_PRICE_CREDITS_3000=price_credits_3000_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://app.lyra.test/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://app.lyra.test/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://app.lyra.test/settings/billing
AUTH_PROVIDER=supabase
SUPABASE_JWT_SECRET=replace-me
# Local development can use Supabase-compatible dev tokens. Production requires AUTH_PROVIDER=cognito.
COGNITO_USER_POOL_ID=ap-northeast-1_replace_me
COGNITO_CLIENT_ID=replace-me
COGNITO_TOKEN_USE=id
# Required only when COGNITO_TOKEN_USE=access.
# COGNITO_REQUIRED_SCOPES=lyra/api
# Optional overrides:
# COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_replace_me
# COGNITO_JWKS_URI=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_replace_me/.well-known/jwks.json
# COGNITO_REQUIRED_GROUPS=customers
ENTERPRISE_STYLE_REFERENCES_ENABLED=true
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_SUPABASE_ID=dev-local-user
DEV_AUTH_BYPASS_EMAIL=dev@local.lyra
